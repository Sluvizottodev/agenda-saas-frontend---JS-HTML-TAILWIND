{
  "name": "projeto_victor_front",
  "version": "1.0.0",
  "description": "Frontend do projeto agenda-saas",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "start": "http-server ./public -p 3000",
    "dev": "nodemon --watch public --ext js,css,html --exec \"http-server ./public -p 3000\"",
    "build:css": "postcss ./styles/tailwind.css -o ./public/assets/tailwind.css --env production",
    "watch:css": "postcss ./styles/tailwind.css -o ./public/assets/tailwind.css --watch",
    "test": ""
  },
  "dependencies": {
    "axios": "^1.4.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "autoprefixer": "^10.4.21",
    "http-server": "^14.1.1",
    "nodemon": "^3.0.3",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.1.16"
  }
}
