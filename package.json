{
  "name": "projeto_victor_front",
  "version": "1.0.0",
  "description": "Frontend do projeto agenda-saas",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "build:css": "npx tailwindcss -i ./public/styles/tailwind.css -o ./public/styles/style.css --minify",
    "watch:css": "npx tailwindcss -i ./public/styles/tailwind.css -o ./public/styles/style.css --watch",
  "start": "http-server ./public -p 3000 -c-1",
  "dev": "nodemon --watch public --ext js,css,html --exec http-server ./public -p 3000 -c-1",
    "test": ""
  },
  "dependencies": {
    "axios": "^1.4.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "autoprefixer": "^10.4.21",
    "http-server": "^14.1.1",
    "nodemon": "^3.0.3",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.4.18"
  }
}
